# ================================================================
# .gitattributes  — paste this into: .gitattributes
# ================================================================
# Git LFS — model weight files
*.pth filter=lfs diff=lfs merge=lfs -text
*.pt  filter=lfs diff=lfs merge=lfs -text
# Treat Jupyter notebooks as text (for proper diffs)
*.ipynb text eol=lf
# Python source
*.py text eol=lf
# Standard text files
*.md  text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.csv text eol=lf
